# bakdb environment file
# Copy to ".env" (same directory you run `bakdb` from) and fill in.
# Hoặc trỏ tới file khác qua biến BAKDB_ENV_FILE=/path/to/file
# Process environment variables override values in .env.

# Loại DB: MySQL | PostgreSQL | SQL Server
# (cũng nhận: mysql, mariadb, postgres, postgresql, pg, sqlserver, mssql)
BAKDB_TYPE=SQL Server

# Có thể chỉ dùng CONN_STRING (sẽ override các field host/port/user/password):
# Ví dụ SQL Server:
#   BAKDB_CONN_STRING=Server=tcp:db.example.com,1433;User Id=sa;Password=secret;
BAKDB_CONN_STRING=

# Hoặc điền từng field rời (dùng khi không set CONN_STRING):
BAKDB_HOST=localhost
BAKDB_PORT=1433
BAKDB_USER=sa
BAKDB_PASSWORD=

# Tên database cần backup (bắt buộc khi chạy backup).
BAKDB_DATABASE=

# Tuỳ chọn: đường dẫn binary (mysqldump / pg_dump / sqlcmd).
BAKDB_BINARY_PATH=

# Tuỳ chọn: thư mục xuất file backup. Hỗ trợ "~" để trỏ về $HOME.
BAKDB_OUTPUT_DIR=

# ── Email (modal gửi file backup qua Gmail) ─────────────────────────────────
# Cảnh báo: App Password là secret, KHÔNG commit file .env.
BAKDB_EMAIL_FROM=
BAKDB_EMAIL_APP_PASSWORD=
# Nhiều địa chỉ cách nhau bởi dấu phẩy hoặc chấm phẩy:
BAKDB_EMAIL_TO=
BAKDB_EMAIL_SUBJECT=Database Backup
